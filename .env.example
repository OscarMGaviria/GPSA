# Habilitar funciones internas (Gantt, Admin, Reporte, etc.)
# En producción debe ser false o no definida
VITE_INTERNAL=false

# ── Autenticación Microsoft (Azure AD) ────────────────────────────────────────
# Requerido para /admin-geojson en modo producción (VITE_ADMIN_API definido)
# Obtener de: Azure Portal → Azure Active Directory → Registros de aplicaciones
VITE_MSAL_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_MSAL_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Scope del API backend. Preguntar a Jhon Fredy el valor correcto.
# Ejemplo: api://<client-id>/.default  o  https://apim-simeva-qa.azure-api.net/.default
VITE_MSAL_API_SCOPE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/.default
